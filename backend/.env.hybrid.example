# Hybrid local — Windows host runs backend/frontend, Docker runs infra only.
# Copy to backend/.env:  Copy-Item backend\.env.hybrid.example backend\.env
# Then replace every CHANGE_ME with real values from .env / .env.selfhost.example
# Never commit backend/.env — it is ignored. Placeholders only here.

# --- Database: Windows host -> Docker postgres via loopback ---
# Must match POSTGRES_PASSWORD in root .env (percent-encode special chars: @->%40)
DATABASE_URL=postgresql+asyncpg://scribe:CHANGE_ME@127.0.0.1:55432/scribe

# --- Redis: Windows host -> Docker redis (private, no password in local) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6479
# REDIS_PASSWORD left empty — scribe_net is the protection locally.
# If you add a password, you must set it in docker-compose.yml redis command
# AND here AND in livekit.yaml — do not set it in only one place.

# --- Qdrant: Windows host -> Docker qdrant ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6433
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_COLLECTION_NAME=documents

# --- LiveKit: Windows host -> Docker livekit ---
# Both endpoints are intentionally localhost-only for the current web product.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_32_chars_min
VOICE_WORKER_HEALTH_URL=http://127.0.0.1:8081
# Host mode auto-start: Windows backend spawns a worker if none running.
VOICE_WORKER_AUTO_START=true

# --- Application / Security (host) ---
DEBUG=true
API_KEY=CHANGE_ME_long_random
APP_ACCESS_PASSCODE=CHANGE_ME_gate_passcode
SESSION_SECRET=CHANGE_ME_64_hex_token_urlsafe
SESSION_TTL_DAYS=30
INTERNAL_API_KEY=CHANGE_ME_different_from_API_KEY
# BACKEND_API_KEY must equal API_KEY for Next.js proxy (frontend/app/api/v1/[...path]/route.ts)
BACKEND_API_KEY=CHANGE_ME_long_random_same_as_API_KEY
BACKEND_ORIGIN=http://127.0.0.1:8000
CORS_ORIGINS=["http://127.0.0.1:3100","http://localhost:3100"]

# --- LLM / STT / TTS ---
# Founder wants Mistral OpenAI-compatible. Verified consumed vars:
#   CUSTOM_LLM_BASE_URL + CUSTOM_LLM_API_KEY are read by voice worker via
#   token metadata (worker.py:113-119 overrides VOICE_LLM_PROVIDER=custom_openai).
#   MISTRAL_API_KEY + MISTRAL_MODEL are fallback when no custom URL is set.
#   SARVAM_API_KEY is used for STT (saaras:v3) + TTS (bulbul:v3).
# All three paths work — choose one:
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
SARVAM_API_KEY=
GROQ_API_KEY=CHANGE_ME_groq_key_for_server_fallback
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- File storage (host) ---
UPLOAD_DIR=uploads
# Supabase not used in hybrid; leave empty.

# --- Limits (host) ---
LIMITS_ENABLED=true
