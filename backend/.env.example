# ============================================================================
# Groq — LLM used by text chat (and the default voice LLM, unless a per-call
# custom model is picked from the UI). Free tier: https://console.groq.com
# ============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Used automatically when a chat message includes an image (upload or paste).
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ============================================================================
# Embeddings (dense vectors) — runs locally, no API key needed.
# ============================================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Alternative: BAAI/bge-m3 (better quality, larger/slower)

# ============================================================================
# Qdrant — vector store for document chunks (dense + BM25 sparse, hybrid search)
# ============================================================================
# Qdrant Cloud (free tier, recommended — survives redeploys, unlike a local
# container on an ephemeral host disk). Take the host from your cluster URL
# WITHOUT the https:// prefix or a trailing slash. Setting QDRANT_API_KEY
# switches the client to TLS automatically, which cloud endpoints require.
#   QDRANT_HOST=xxxxxxxx.aws.cloud.qdrant.io
#   QDRANT_PORT=6333
# Local Docker instead: host=localhost, port=6333, leave the API key empty.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# ============================================================================
# Redis — optional cache for live conversation context (falls back to an
# in-memory dict automatically if unreachable; nothing breaks without it).
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Application / RAG tuning
# ============================================================================
DEBUG=False
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
MAX_TOP_K=50

# Demo mode: visitors who paste their own Groq key (no login) get an
# isolated tenant with these caps, regardless of what the client requests.
DEMO_MAX_DOCUMENTS=4
DEMO_TOP_K=3

# ============================================================================
# Security & rate limiting
# ============================================================================
# Set this to a long random string to require the X-API-Key header on every
# request. Leave empty ONLY for local development (auth is fully disabled
# and a warning is logged at startup).
#
# IMPORTANT: API_KEY does NOT protect your documents from the public. The
# frontend proxy attaches it to every anonymous request, so it authenticates
# the proxy, not the person. APP_ACCESS_PASSCODE below is what protects you.
API_KEY=

# --- Passcode gate (REQUIRED before deploying anywhere public) --------------
# Visitors must enter this once; the server then sets a signed, HttpOnly
# session cookie. Without it, anyone who knows your URL can list, download,
# and DELETE every document you have uploaded.
APP_ACCESS_PASSCODE=
# Signing key for those session cookies. Required whenever APP_ACCESS_PASSCODE
# is set — the app refuses to start otherwise. Changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Shared secret for voice-worker -> API calls (/voice/retrieve, /voice/history).
# Those routes accept a tenant id from the caller, so they must be unreachable
# from the browser. Use a DIFFERENT value from API_KEY, and never give it to
# the frontend. Falls back to API_KEY when empty.
INTERNAL_API_KEY=

# Enable only when running behind a proxy that overwrites X-Forwarded-For
# (Render, Fly, Vercel, nginx). If anything can reach the API directly, leave
# this false — otherwise a caller can forge the header and evade rate limits.
TRUST_PROXY_HEADERS=False

RATE_LIMIT_ENABLED=True
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ============================================================================
# Database (document + conversation metadata — chunk text/vectors live in
# Qdrant instead, see above)
# ============================================================================
# Supabase Postgres. Keep the "+asyncpg" driver suffix, and percent-encode
# special characters in the password (@ -> %40, # -> %23).
#   postgresql+asyncpg://postgres.<ref>:<PASSWORD>@<host>.pooler.supabase.com:5432/postgres
# Local dev without Postgres can still use: sqlite+aiosqlite:///./rag.db
DATABASE_URL=

# ============================================================================
# CORS
# ============================================================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================================================
# Voice (LiveKit Agents + Sarvam STT/TTS). Leave LIVEKIT_URL empty to disable
# voice entirely — /voice/token returns 503 and the UI just won't offer it.
# Get a free LiveKit Cloud project: https://cloud.livekit.io
# ============================================================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sarvam AI — STT + TTS for voice. Get a key: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Where the API server can reach the voice worker's built-in health check.
# Local dev default is fine as-is; docker-compose overrides this to
# http://voice-worker:8081 automatically.
VOICE_WORKER_HEALTH_URL=http://localhost:8081

# Optional: only needed if you want a server-side fallback for a custom
# OpenAI-compatible model (e.g. Mistral) instead of always pasting a key in
# the UI's "Add a model" form. Not required — the UI path never touches this.
MISTRAL_API_KEY=

# ============================================================================
# File storage (uploaded documents)
# ============================================================================
# Leave these empty and files go to UPLOAD_DIR on local disk — fine for local
# development, but on Render/Fly/Railway free tiers the container filesystem is
# WIPED on every redeploy, so every uploaded document is lost and download,
# editing, and image questions all break.
#
# Same Supabase project as DATABASE_URL. Create a bucket named below and keep
# it PRIVATE — a public bucket makes every uploaded document readable by URL.
# The service-role key is server-side only; never expose it to the browser.
#   Dashboard -> Project Settings -> API -> service_role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
UPLOAD_DIR=uploads

# ============================================================================
# Document retention
# ============================================================================
# Uploads are session-scoped. The file lives on a disk a redeploy wipes, but
# the Postgres row and Qdrant vectors do not — so without a sweep the app keeps
# listing documents whose file is gone: chat still answers from indexed text,
# and only download, editing, and image questions fail. A document that looks
# present and breaks on touch is worse than one that disappeared.
#
# Hours before a document is deleted from all three stores. 0 disables expiry
# (orphan cleanup still runs).
DOCUMENT_TTL_HOURS=24
# How often to sweep. 0 disables cleanup entirely.
CLEANUP_INTERVAL_MINUTES=60
# Owner documents are exempt from the TTL by default — the passcode holder is
# curating a library, not passing through. Set True for a fully ephemeral
# deployment where even the owner's uploads expire.
CLEANUP_INCLUDES_OWNER=False


# Every limit honours 0 = disabled. Add to backend/.env and restart:

# DAILY_CALL_BUDGET=0
# DAILY_MINUTE_BUDGET=0
# DIRECTORY_VELOCITY_MAX_BUSINESSES=0
# DIRECTORY_MAX_CALL_SECONDS=0
# DIRECTORY_IDLE_TIMEOUT_SECONDS=0
# DIRECTORY_SESSIONS_PER_DAY=500
# RATE_LIMIT_ENABLED=false
# I verified this actually works rather than assuming it:

# daily budget      : DISABLED
# over_budget now   : False
# velocity limit    : DISABLED
# max call seconds  : 0 (no ceiling)
# idle timeout      : 0 (never hang up)
# sessions per link : 500
# request rate limit: DISABLED

# ─────────────────────────────────────────────────────────────────────────
# SPEND & ABUSE LIMITS
#
# LIMITS_ENABLED is the master switch.
#   false -> every ceiling below is OFF and the values are ignored. Use while
#            developing; startup logs a loud warning so it cannot be mistaken
#            for a healthy instance.
#   true  -> the values below are enforced exactly as written. This is the
#            default, so a deployment that never sets it is protected.
#
# Every value is live — edit the number and restart. Nothing needs commenting
# out to develop; the switch overrides all of them.
#
# Units are stated per line. 0 means "no ceiling" everywhere except
# DIRECTORY_SESSIONS_PER_DAY, where 0 would mean "no calls allowed".
# ─────────────────────────────────────────────────────────────────────────

LIMITS_ENABLED=false


# ---- Per workspace, per day ---------------------------------------------
# The only ceiling that bounds TOTAL spend. Everything else here is per-link,
# and links are free to create, so these are the real backstop.
# On breach: new calls for that workspace are refused with "reached its limit
# for today". Calls already in progress are not cut off. Resets midnight UTC.
# Owners see this at Overview -> Today's usage.

# COUNT of voice calls per workspace per day. 0 = unlimited.
DAILY_CALL_BUDGET=100

# MINUTES of total talk time per workspace per day. 0 = unlimited.
DAILY_MINUTE_BUDGET=200


# ---- Per call, public-directory callers only ----------------------------
# Applies ONLY to strangers who found the business in the public directory.
# Invite links the owner sent to someone they know are unaffected.
# LiveKit room minutes bill to the platform first and are recovered from the
# owner afterwards, so these protect our margin before the owner's quota.

# SECONDS of wall-clock call length before the agent says goodbye and hangs
# up. 180 = 3 minutes. 0 = no ceiling.
DIRECTORY_MAX_CALL_SECONDS=180

# SECONDS of continuous silence (nobody speaking at all) before hanging up.
# Catches a line someone opened and walked away from, which costs exactly as
# much as a real conversation. 0 = never hang up on silence.
DIRECTORY_IDLE_TIMEOUT_SECONDS=25


# ---- Per directory link -------------------------------------------------
# Copied onto each link when it is created, so changes apply to NEW links
# only — links already issued keep the values they were created with.

# COUNT of calls per day a single directory link may make. Must be >= 1.
DIRECTORY_SESSIONS_PER_DAY=3

# DAYS a directory link stays valid before it stops working.
DIRECTORY_LINK_TTL_DAYS=1


# ---- Cross-tenant velocity ----------------------------------------------
# The only check that looks across workspaces. One visitor taking links to
# many different businesses in quick succession is not a customer, and no
# per-workspace limit can see that pattern — each owner sees one ordinary
# visitor. Keyed on a browser id, not IP: a mobile IP rotates on tower
# handover, and an office behind one NAT shares an address.
# On breach: /directory/connect returns "please wait a few minutes".

# COUNT of distinct businesses one browser may connect to inside the window
# below. 0 = check disabled.
DIRECTORY_VELOCITY_MAX_BUSINESSES=5

# MINUTES the count above is measured over.
DIRECTORY_VELOCITY_WINDOW_MIN=10


# ---- HTTP request rate limits -------------------------------------------
# Per caller (owner session, demo key, or IP), sliding one-minute window.
# Also covers sign-in, which is the one endpoint where guessing pays — keep
# this enabled in production.

# true/false. Turning this off disables login brute-force protection too.
RATE_LIMIT_ENABLED=True

# COUNT of chat/query requests allowed per caller per MINUTE.
RATE_LIMIT_QUERY_PER_MINUTE=20

# COUNT of document uploads allowed per caller per MINUTE.
RATE_LIMIT_UPLOAD_PER_MINUTE=10
