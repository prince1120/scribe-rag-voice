# Copy to .env at the REPO ROOT:  cp .env.selfhost.example .env
# Then fill every *_CHANGE_ME / devkey / devsecret. Never commit .env.
# This file contains ONLY placeholders.

# --- PostgreSQL (Compose service: postgres:5432 internally) ---
# POSTGRES_* init the container on first start only. DATABASE_URL is what the
# backend actually uses. They MUST stay in sync — if you change the password
# here, also change it in DATABASE_URL.  If the password contains @ : / ? # &
# or % it MUST be percent-encoded in DATABASE_URL: @->%40  :->%3A  /->%2F.
# Compose already defaults DATABASE_URL from these three vars, so you can
# leave DATABASE_URL unset and it will be built as
#   postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Set DATABASE_URL explicitly only if you need a different host/port (dev override).
POSTGRES_DB=scribe
POSTGRES_USER=scribe
POSTGRES_PASSWORD=scribe_secret_change_me
# Leave empty to use the Compose default built from POSTGRES_*; or set explicitly:
# DATABASE_URL=postgresql+asyncpg://scribe:scribe_secret_change_me@postgres:5432/scribe
DATABASE_URL=

# --- Redis (Compose service: redis:6379 internally) ---
# Redis is NOT exposed to the host and has NO password in local dev — the
# private Docker network (scribe_net) is the only protection.  Do NOT add a
# REDIS_PASSWORD here unless you also configure the same password in
# docker-compose.yml for the redis service AND in backend/livekit env.
# Local dev: keep empty. Production: see docs/SELF_HOSTED_DOCKER.md.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Qdrant (Compose service: qdrant:6333 internally) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_URL=http://qdrant:6333

# --- LiveKit self-hosted (Compose service: livekit) ---
# Internal URL for backend/worker (private network)
LIVEKIT_URL=ws://livekit:7880
# URL returned to the browser; current web-only setup uses this same Windows host.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_generate_with_openssl_rand_hex_32

# --- Backend ---
API_KEY=change_me_long_random
# CRITICAL: BACKEND_API_KEY MUST equal API_KEY — the Next.js proxy at
# frontend/app/api/v1/[...path]/route.ts forwards BACKEND_API_KEY as
# X-API-Key to the backend. If they differ, every frontend request 401s.
#   BACKEND_API_KEY = API_KEY   (copy the same value)
APP_ACCESS_PASSCODE=change_me_gate_passcode
SESSION_SECRET=change_me_64_hex_chars_generate_with_secrets_token_urlsafe
SESSION_TTL_DAYS=30
INTERNAL_API_KEY=change_me_different_from_API_KEY

# Frontend proxy needs the backend's API_KEY (server-side only).
BACKEND_API_KEY=change_me_long_random
BACKEND_ORIGIN=http://backend:8000

# --- Worker mode ---
# Local `python run_backend.py` without Docker: true  (auto-spawn for dev).
# Docker Compose: false (dedicated voice-worker container).  Do not set true in Docker.
VOICE_WORKER_AUTO_START=false
DEBUG=true

# Where the API can reach the voice worker health endpoint (private network).
VOICE_WORKER_HEALTH_URL=http://voice-worker:8081

# --- Frontend public ---
NEXT_PUBLIC_LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- LLM / STT / TTS (backend reads from per-workspace vault, but keep server fallbacks empty or placeholders) ---
GROQ_API_KEY=your_groq_api_key_here_if_you_want_server_fallback
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Mistral OpenAI-compatible (alternative to Groq):
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
SARVAM_API_KEY=

# --- Configurable host ports (avoid 3000/5432/6333/6334/6379/8123/9000/9001/9009) ---
SCRIBE_FRONTEND_PORT=3100
SCRIBE_BACKEND_PORT=8100
SCRIBE_LIVEKIT_HTTP_PORT=7880
SCRIBE_LIVEKIT_TCP_PORT=7881
SCRIBE_LIVEKIT_UDP_PORT=7882
# Dev override ports (only when using docker-compose.dev.yml):
SCRIBE_POSTGRES_PORT=55432
SCRIBE_REDIS_PORT=6479
SCRIBE_QDRANT_HTTP_PORT=6433
SCRIBE_QDRANT_GRPC_PORT=6434

# --- CORS (add dev tunnels here) ---
CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
