        <mxCell id="mv-2" value="&lt;b&gt;2. Silero VAD&lt;/b&gt;&lt;br&gt;Detects Speech Start &amp; End&lt;br&gt;Filters silence &amp; noise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="330" y="60" width="260" height="85" as="geometry"/>
