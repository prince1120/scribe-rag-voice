        <mxCell id="mv-6" value="&lt;b&gt;6. Sarvam TTS Persona&lt;/b&gt;&lt;br&gt;Voices: Anushka, Abhishek&lt;br&gt;Streaming Audio Waveform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="1600" y="60" width="280" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mv-7" value="&lt;b&gt;7. Audio Playback&lt;/b&gt;&lt;br&gt;AudioContext Buffer Queue&lt;br&gt;Customer hears live answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="1920" y="60" width="270" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="mv-db" value="&lt;b style=&quot;font-size: 15px; color: #831843;&quot;&gt;💾 Turn-by-Turn Logging &amp; Database State (Async SQLAlchemy)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 12px; padding: 4px;&quot;&gt;• &lt;b&gt;session_turns:&lt;/b&gt; User query text + Assistant response text + Timestamps&lt;br&gt;• &lt;b&gt;contact_sessions:&lt;/b&gt; Increments message_count (e.g. 5 dialogue turns)&lt;br&gt;• &lt;b&gt;Zero-Turn Ghost Cleanup:&lt;/b&gt; Empty sessions pruned if caller leaves without talking&lt;br&gt;• &lt;b&gt;Dashboard Live Feed:&lt;/b&gt; Instantly appears in Overview 4 totals &amp; Completed Talks&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="30" y="180" width="2160" height="120" as="geometry"/>
