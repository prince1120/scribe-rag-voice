        <mxCell id="mbe2" edge="1" source="mb-s2" target="mb-s3" parent="m-lane-business" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;"/>
        <mxCell id="mbe3" edge="1" source="mb-s3" target="mb-s4" parent="m-lane-business" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;"/>

        <!-- PUBLIC CALLER & SECURITY FLOW -->
        <mxCell id="m-lane-caller" value="&lt;b style=&quot;font-size: 18px; color: #7E22CE;&quot;&gt;🌐 PUBLIC CUSTOMER ACCESS &amp; SMART CALLER RECEPTION FLOW&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="610" width="2300" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="mc-1" value="&lt;b&gt;1. Customer Entry&lt;/b&gt;&lt;br&gt;Directory (/directory) OR&lt;br&gt;Token Link (/t/:token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=2;" vertex="1" parent="m-lane-caller">
          <mxGeometry x="30" y="55" width="280" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mc-2" value="&lt;b&gt;2. Smart Deduplication&lt;/b&gt;&lt;br&gt;Has caller contacted agent before?&lt;br&gt;&lt;font color=&quot;#059669&quot;&gt;YES ➔ Reuse contact &amp; history&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;NO ➔ Create new contact row&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=2;" vertex="1" parent="m-lane-caller">
          <mxGeometry x="350" y="55" width="340" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mc-3" value="&lt;b&gt;3. Security &amp; PIN Gate&lt;/b&gt;&lt;br&gt;• Validate Agent Live ('deployed')&lt;br&gt;• Check contact not blocked&lt;br&gt;• Check optional PIN passcode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=2;" vertex="1" parent="m-lane-caller">
          <mxGeometry x="730" y="55" width="320" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mc-4" value="&lt;b&gt;4. Hardware Device Binding&lt;/b&gt;&lt;br&gt;Compute Hash(IP + UserAgent)&lt;br&gt;• If unbound ➔ Lock to device&lt;br&gt;• If bound ➔ Verify device match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=2;" vertex="1" parent="m-lane-caller">
          <mxGeometry x="1090" y="55" width="340" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mc-5" value="&lt;b&gt;5. Channel Launch&lt;/b&gt;&lt;br&gt;Customer Chooses:&lt;br&gt;📞 Voice Call (Web Audio) OR&lt;br&gt;💬 Text Chat Interface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;" vertex="1" parent="m-lane-caller">
          <mxGeometry x="1470" y="55" width="340" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mc-6" value="&lt;b&gt;6. Register Session&lt;/b&gt;&lt;br&gt;Create row in contact_sessions&lt;br&gt;Snapshot Agent &amp; Business Name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="m-lane-caller">
          <mxGeometry x="1850" y="55" width="320" height="85" as="geometry"/>
