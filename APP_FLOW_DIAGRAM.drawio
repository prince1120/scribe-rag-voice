        <!-- BRANCH B: BUSINESS CONSOLE MODE -->
        <mxCell id="m-lane-business" value="&lt;b style=&quot;font-size: 18px; color: #1E40AF;&quot;&gt;🏢 MODE B: BUSINESS VOICE &amp; CHAT CONSOLE (/dashboard)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="240" width="1120" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="mb-s1" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;1. Overview (/dashboard)&lt;/b&gt;&lt;hr&gt;• 4 Metric Cards&lt;br&gt;• Completed Talks (5/page)&lt;br&gt;• Transcript Slide-Over" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;" vertex="1" parent="m-lane-business">
          <mxGeometry x="30" y="55" width="240" height="120" as="geometry"/>
