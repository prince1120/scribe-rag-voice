        <!-- REAL-TIME VOICE PIPELINE -->
        <mxCell id="m-lane-voice" value="&lt;b style=&quot;font-size: 18px; color: #B45309;&quot;&gt;🎙️ REAL-TIME BIDIRECTIONAL VOICE CALL &amp; RAG ENGINE PIPELINE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="840" width="2300" height="420" as="geometry"/>
