        <mxCell id="mv-3" value="&lt;b&gt;3. Sarvam STT&lt;/b&gt;&lt;br&gt;Streaming Speech-to-Text&lt;br&gt;Transcribes user question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="630" y="60" width="260" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mv-4" value="&lt;b&gt;4. Context &amp; RAG Search&lt;/b&gt;&lt;br&gt;Live Date/Time Context Line&lt;br&gt;+ Hybrid Vector Document Search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="930" y="60" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mv-5" value="&lt;b&gt;5. Groq LLaMA 3.1/3.3&lt;/b&gt;&lt;br&gt;Ultra Fast Token Stream&lt;br&gt;Voice Script Conciseness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="1280" y="60" width="280" height="85" as="geometry"/>
