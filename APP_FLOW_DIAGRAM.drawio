  <diagram id="tab-master" name="1. Master System Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="m-hdr" value="&lt;b style=&quot;font-size: 24px; color: #0F172A;&quot;&gt;SCRIBE AI PLATFORM — COMPLETE MASTER SYSTEM WORKFLOW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 14px; color: #475569;&quot;&gt;Dual Operational Modes: Personal 3-Pane Research Workspace &amp; Business Multi-Channel Voice Console&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="2300" height="80" as="geometry"/>
        </mxCell>

        <!-- STEP 0: ENTRY & IDENTITY RESOLUTION -->
        <mxCell id="m-step0" value="&lt;b style=&quot;font-size: 16px; color: #0F172A;&quot;&gt;STEP 0: ENTRY &amp; IDENTITY RESOLUTION (/setup or SessionGate)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #475569;&quot;&gt;Resolves Identity Headers (X-User-Groq-Key, X-User-Sarvam-Key, X-Client-Id) or Session Cookie ➔ Determines Mode&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="2300" height="70" as="geometry"/>
        </mxCell>

        <!-- BRANCH A: PERSONAL 3-PANE MODE -->
        <mxCell id="m-lane-personal" value="&lt;b style=&quot;font-size: 18px; color: #0369A1;&quot;&gt;📘 MODE A: PERSONAL 3-PANE RAG &amp; VOICE WORKSPACE (app/page.tsx)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="1120" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="mp-p1" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Pane 1: Knowledge Base&lt;/b&gt;&lt;hr&gt;• PDF/DOCX/TXT Ingestion&lt;br&gt;• 500-Token Chunking&lt;br&gt;• Document Selection Chips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;" vertex="1" parent="m-lane-personal">
          <mxGeometry x="30" y="55" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mp-p2" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Pane 2: Chat &amp; Citations&lt;/b&gt;&lt;hr&gt;• Multi-modal Composer&lt;br&gt;• Streaming Markdown&lt;br&gt;• In-Line Citations [1.1], [1.2]&lt;br&gt;• Latency: Retrieval &amp; TTFT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;" vertex="1" parent="m-lane-personal">
          <mxGeometry x="300" y="55" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mp-p3" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Pane 3: Source Inspector&lt;/b&gt;&lt;hr&gt;• Slide-Over Ground Truth&lt;br&gt;• Page # &amp; Chunk Index&lt;br&gt;• Vector Similarity Score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;" vertex="1" parent="m-lane-personal">
          <mxGeometry x="590" y="55" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mp-p4" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;🎙️ Voice Call Modal&lt;/b&gt;&lt;hr&gt;Live Voice Dialogue with Documents via Sarvam STT/TTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;" vertex="1" parent="m-lane-personal">
          <mxGeometry x="870" y="55" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mp-track" value="&lt;b style=&quot;font-size: 13px; color: #0369A1;&quot;&gt;⚡ Personal Request Tracking:&lt;/b&gt; Query ➔ Vector Search (retrieval_ms) ➔ Groq LPU (ttft_ms) ➔ Streaming Markdown + Citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1;align=center;" vertex="1" parent="m-lane-personal">
          <mxGeometry x="30" y="200" width="1060" height="60" as="geometry"/>
