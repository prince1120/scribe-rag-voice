        <mxCell id="mb-s2" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;2. Assistant (/agent)&lt;/b&gt;&lt;hr&gt;• Voice &amp; Chat Prompts&lt;br&gt;• Anushka / Abhishek Persona&lt;br&gt;• Live Deployment Toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;" vertex="1" parent="m-lane-business">
