        <mxCell id="mb-s4" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;4. Settings (/settings)&lt;/b&gt;&lt;hr&gt;• Business Name &amp; Category&lt;br&gt;• Encrypted Groq/Sarvam Keys&lt;br&gt;• Owner Profile &amp; Password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;" vertex="1" parent="m-lane-business">
          <mxGeometry x="850" y="55" width="240" height="120" as="geometry"/>
