        <mxCell id="mb-cache" value="&lt;b style=&quot;font-size: 13px; color: #16A34A;&quot;&gt;⚡ workspaceCache.ts:&lt;/b&gt; In-Memory Singleton + LocalStorage SWR ➔ 0ms Instant Rendering for Business Name &amp; Live Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1;align=center;" vertex="1" parent="m-lane-business">
