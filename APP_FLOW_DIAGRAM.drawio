        <mxCell id="mv-1" value="&lt;b&gt;1. Web Audio Input&lt;/b&gt;&lt;br&gt;Microphone 16kHz PCM&lt;br&gt;WebSocket (/voice/stream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;" vertex="1" parent="m-lane-voice">
          <mxGeometry x="30" y="60" width="260" height="85" as="geometry"/>
